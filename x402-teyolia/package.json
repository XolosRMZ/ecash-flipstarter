{
  "name": "x402-teyolia",
  "version": "0.0.0",
  "private": true,
  "description": "Proceso x402 aislado de Teyolia (TA-2, PR-1): esqueleto sin llaves, sin fondos, kill switch apagado por defecto.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist/main.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node scripts/dist-manifest.mjs --build",
    "check:dist": "node scripts/dist-manifest.mjs --check && node scripts/dist-manifest.mjs --rebuild-compare",
    "test": "node --test --test-reporter=spec test/*.test.mjs",
    "check:graph": "node scripts/check-graph.mjs dist/main.js && node scripts/check-graph.mjs --surface vendor",
    "check:vendor": "node scripts/check-vendor.mjs",
    "inventory": "node scripts/inventory.mjs --write",
    "inventory:check": "node scripts/inventory.mjs --check"
  },
  "dependencies": {
    "@x402-xec/core": "file:vendor/x402-xec-0f409de/x402-xec-core-0.1.0.tgz",
    "@x402-xec/express": "file:vendor/x402-xec-0f409de/x402-xec-express-0.1.0.tgz",
    "express": "5.2.1",
    "supports-color": "8.1.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  },
  "overrides": {
    "zod": "4.4.3",
    "ecashaddrjs": "2.0.1",
    "@scure/bip32": "1.7.0",
    "@scure/base": "1.2.6",
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0"
  }
}
